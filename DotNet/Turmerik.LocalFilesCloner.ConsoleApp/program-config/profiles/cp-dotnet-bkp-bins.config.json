{
  "ProfileName": "cp-dotnet-bkp-bins",
  "FileGroups": [
    {
      "InputDirPath": "|$TURMERIK_REPO_DIR|/DotNet",
      "CloneDirPath": "|$LOCAL_APP_DATA|/Turmerik/Apps",
      "DfInputDirFilter": {
        "ExcludedRelPathRegexes": [
          "^\\/app-env-locator\\.json$",
          "^\\/trmrk-localdevice-paths\\.json$"
        ]
      },
      "DfBeforeCloneDestnCleanupFilter": {
        "ExcludedRelPathRegexes": [
          "^\\/app-env-locator\\.json$",
          "^\\/trmrk-localdevice-paths\\.json$",
          "^\\/_.+\\.exe"
        ]
      },
      "Folders": [
        {
          "InputDirPath": "Turmerik.LocalFilesCloner.ConsoleApp/bin/Release/net10.0",
          "CloneDirPath": "Bin/Turmerik.LocalFilesCloner.CmdApp/Release/net10.0"
        }
      ]
    }
  ]
}
