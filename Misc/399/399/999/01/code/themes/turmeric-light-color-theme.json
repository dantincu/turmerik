  "tokenColors": [
    {
      "settings": {
        "foreground": "#4A2E00"
      }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#8A6B2E",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#5C7A1E"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": {
        "foreground": "#B85C00"
      }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": {
        "foreground": "#C97800"
      }
    },
    {
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#7A5518"
      }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#A85D00"
      }
    },
    {
      "scope": ["entity.name.class", "entity.name.type", "support.class", "support.type"],
      "settings": {
        "foreground": "#9C5B00",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["variable", "variable.other"],
      "settings": {
        "foreground": "#4A2E00"
      }
    },
    {
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#7A4A00"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#A05A1E"
      }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#C97800"
      }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": {
        "foreground": "#6B4A0A"
      }
    },
    {
      "scope": ["support.constant", "constant.other"],
      "settings": {
        "foreground": "#B85C00"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#C0392B"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#C97800",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#5C7A1E"
      }
    },
    {
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#C0392B"
      }
    },
    {
      "scope": ["markup.link"],
      "settings": {
        "foreground": "#A85D00"
      }
    }
  ]
}
