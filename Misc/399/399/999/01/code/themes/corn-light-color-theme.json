  "tokenColors": [
    {
      "settings": {
        "foreground": "#4A3A00"
      }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#8F7A24",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#4F7942"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": {
        "foreground": "#B8901A"
      }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": {
        "foreground": "#D4A017"
      }
    },
    {
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#7A6418"
      }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#A3801A"
      }
    },
    {
      "scope": ["entity.name.class", "entity.name.type", "support.class", "support.type"],
      "settings": {
        "foreground": "#A3801A",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["variable", "variable.other"],
      "settings": {
        "foreground": "#4A3A00"
      }
    },
    {
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#7A5C10"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#A0803A"
      }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#D4A017"
      }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": {
        "foreground": "#7A6418"
      }
    },
    {
      "scope": ["support.constant", "constant.other"],
      "settings": {
        "foreground": "#B8901A"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#C0392B"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#D4A017",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#4F7942"
      }
    },
    {
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#C0392B"
      }
    },
    {
      "scope": ["markup.link"],
      "settings": {
        "foreground": "#4F7942"
      }
    }
  ]
}
