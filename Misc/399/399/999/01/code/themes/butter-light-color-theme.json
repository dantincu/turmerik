  "tokenColors": [
    {
      "settings": {
        "foreground": "#4A3E12"
      }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#8A8034",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#7A8F3E"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": {
        "foreground": "#B0900E"
      }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": {
        "foreground": "#C9A83E"
      }
    },
    {
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#7A6830"
      }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#8F781A"
      }
    },
    {
      "scope": ["entity.name.class", "entity.name.type", "support.class", "support.type"],
      "settings": {
        "foreground": "#8F781A",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["variable", "variable.other"],
      "settings": {
        "foreground": "#4A3E12"
      }
    },
    {
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#7A6018"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#A0863A"
      }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#C9A83E"
      }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": {
        "foreground": "#7A6830"
      }
    },
    {
      "scope": ["support.constant", "constant.other"],
      "settings": {
        "foreground": "#B0900E"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#C0392B"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#C9A83E",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#7A8F3E"
      }
    },
    {
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#C0392B"
      }
    },
    {
      "scope": ["markup.link"],
      "settings": {
        "foreground": "#8F781A"
      }
    }
  ]
}
