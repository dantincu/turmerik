  "tokenColors": [
    {
      "settings": {
        "foreground": "#5C3A1E"
      }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#A9793F",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#74902A"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": {
        "foreground": "#C08552"
      }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": {
        "foreground": "#B5651D"
      }
    },
    {
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#8F5A26"
      }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#8F5A26"
      }
    },
    {
      "scope": ["entity.name.class", "entity.name.type", "support.class", "support.type"],
      "settings": {
        "foreground": "#A56B1C",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["variable", "variable.other"],
      "settings": {
        "foreground": "#5C3A1E"
      }
    },
    {
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#8F4518"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#A0522D"
      }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#B5651D"
      }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": {
        "foreground": "#8A6238"
      }
    },
    {
      "scope": ["support.constant", "constant.other"],
      "settings": {
        "foreground": "#C08552"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#C0392B"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#B5651D",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#74902A"
      }
    },
    {
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#C0392B"
      }
    },
    {
      "scope": ["markup.link"],
      "settings": {
        "foreground": "#A0522D"
      }
    }
  ]
}
