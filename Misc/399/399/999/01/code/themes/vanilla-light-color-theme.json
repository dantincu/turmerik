  "tokenColors": [
    {
      "settings": {
        "foreground": "#5A4632"
      }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#A0906E",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#7A8B5C"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": {
        "foreground": "#B08A5A"
      }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": {
        "foreground": "#9C7A45"
      }
    },
    {
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#8A7355"
      }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#8A6B42"
      }
    },
    {
      "scope": ["entity.name.class", "entity.name.type", "support.class", "support.type"],
      "settings": {
        "foreground": "#806B3D",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["variable", "variable.other"],
      "settings": {
        "foreground": "#5A4632"
      }
    },
    {
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#7A6040"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#96784A"
      }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#9C7A45"
      }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": {
        "foreground": "#8A7355"
      }
    },
    {
      "scope": ["support.constant", "constant.other"],
      "settings": {
        "foreground": "#B08A5A"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#C0392B"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#9C7A45",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#7A8B5C"
      }
    },
    {
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#C0392B"
      }
    },
    {
      "scope": ["markup.link"],
      "settings": {
        "foreground": "#7A6040"
      }
    }
  ]
}
